# ==============================================================================
# TATADANA FINTECH SAAS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=tatadana-exports

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_BASE_URL=https://tatadana.id
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TataDanaBot

# AI Providers (Multi-Provider: Gemini / OpenAI / DeepSeek)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Jakarta
